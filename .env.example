# =============================================================================
# Compose-level env contract for the self-hosted firecrawl + MCP stack.
# Copy to `.env`, fill in the values, then `docker compose up -d`.
# `.env` is gitignored; this template is committed.
# =============================================================================

# --- Traefik network --------------------------------------------------------
# Name of the external Docker network your Traefik instance routes from.
TRAEFIK_NETWORK=traefik

# --- Firecrawl backend -------------------------------------------------------
# API key — any string. Set this to lock the API to a single key.
# Generate with: openssl rand -hex 20 | sed 's/^/fc-/'
TEST_API_KEY=

# Used internally by the MCP server to talk to the API.
FIRECRAWL_API_KEY=

# Bull-Board + admin endpoint password.
BULL_AUTH_KEY=

# Postgres for the nuq queue.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

USE_DB_AUTHENTICATION=false

# --- LLM provider for MCP tools (research, enrich, brand audit, etc.) -------
# OpenRouter by default. Leave LLM_BASE_URL blank to use OpenAI directly.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_SMART=anthropic/claude-sonnet-4-6
LLM_MODEL_FAST=anthropic/claude-haiku-4-5

# Firecrawl backend's own LLM features (extract endpoint).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Self-hosted /v2/agent (omp sidecar). OpenRouter key required even for free models.
# Free default; switch to openrouter/openai/gpt-4o-mini (~$0.001/call) if the
# free tier hits persistent rate limits at peak hours.
OPENROUTER_API_KEY=
AGENT_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
AGENT_MAX_SOURCES=5
AGENT_TIMEOUT_MS=180000

# --- Optional / tuning -------------------------------------------------------
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

# Outbound proxy for scrapes (leave blank for direct egress).
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Slack webhook for alerts.
SLACK_WEBHOOK_URL=
